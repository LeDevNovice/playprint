---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Playprint">
  <main class="mx-auto max-w-md p-6">
    <section class="rounded-xl border border-border bg-surface p-6">
      <p class="text-xs font-bold uppercase tracking-[0.08em] text-score-high">Very likely</p>
      <p class="text-5xl font-bold tabular-nums text-score-high">78 %</p>
      <p class="font-mono text-xs text-dim">847 similar profiles · fiability 72 %</p>
    </section>
  </main>
</Layout>